{
  "name": "lurus-docs",
  "version": "1.0.0",
  "type": "module",
  "description": "Lurus AI Platform Documentation — API, Kova, MemX, Lucrum, Switch, Creator, Lumen, Forge",
  "scripts": {
    "sync": "bun scripts/sync.ts",
    "gen-feed": "bun scripts/gen-feed.ts",
    "dev": "vitepress dev docs",
    "dev:server": "bun run --watch server/index.ts",
    "build": "vitepress build docs",
    "preview": "vitepress preview docs",
    "deploy": "bun run sync && bun run gen-feed && bun run build",
    "start": "bun run server/index.ts",
    "dev:internal": "vitepress dev internal --port 5174",
    "build:internal": "bun scripts/secrets-guard.ts && bun scripts/inject-build-meta.ts && vitepress build internal",
    "preview:internal": "vitepress preview internal --port 4174"
  },
  "keywords": [
    "lurus",
    "api",
    "documentation"
  ],
  "author": "Lurus Technologies",
  "license": "MIT",
  "dependencies": {
    "dompurify": "^3.3.3",
    "hono": "^4.7.0",
    "lucide-vue-next": "^1.0.0",
    "markdown-it": "^14.0.0",
    "mermaid": "^11.14.0"
  },
  "devDependencies": {
    "vitepress": "^1.6.4",
    "vitepress-plugin-llms": "^1.3.4",
    "vitepress-plugin-tabs": "^0.5.0"
  }
}
