# Lurus Internal docs — staging build for R6.
# Stage 1 builds VitePress static output (with secrets-guard + lint).
# Stage 2 is nginx:alpine serving static files. No API server needed.
# Optimized for slow China apt/apk mirror — alpine over debian.

FROM oven/bun:1-alpine AS builder
RUN apk add --no-cache git
WORKDIR /build
COPY package.json bun.lock* ./
RUN bun install --frozen-lockfile
COPY . .
RUN bun run build:internal

FROM nginx:alpine
RUN rm -rf /usr/share/nginx/html/*
COPY --from=builder /build/dist-internal /usr/share/nginx/html
COPY deploy/internal-nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
